# ── Bot ───────────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
ANNOUNCEMENT_CHANNEL_ID=123456789012345678

# Optional: set to your Discord server (guild) ID for instant slash command sync.
# Without this, global sync takes up to 1 hour to propagate after bot startup.
GUILD_ID=123456789012345678

# Agent connection (LAN address of your main server)
AGENT_URL=http://192.168.1.100:8420
AGENT_API_KEY=change_me_to_a_long_random_secret

# Wake-on-LAN
WOL_MAC_ADDRESS=AA:BB:CC:DD:EE:FF
WOL_BROADCAST_ADDRESS=192.168.1.255

# Permissions — exact name of the Discord role that can run management commands
REQUIRED_ROLE_NAME=Server Admin

# How often (seconds) the bot ships buffered audit logs to the agent (default: 3600 = 1 hour)
LOG_SHIP_INTERVAL_SECONDS=3600

# How often (seconds) the bot polls the agent for status (default: 30)
STATUS_POLL_INTERVAL_SECONDS=30

# ── Agent ─────────────────────────────────────────────────────────────────────
API_KEY=change_me_to_a_long_random_secret

# Comma-separated short names of game services to track
# Each name maps to a systemd unit: podman-<name>.service
TRACKED_SERVICES=palworld,valheim

# Directory where audit logs from the bot are stored on the main server
LOG_DIR=/var/log/servitor

# Host/port the agent listens on (LAN only — do not expose to the internet)
HOST=0.0.0.0
PORT=8420
